{
    "version": "2.0.0",
    "tasks": [
        // ---------------------------------------------------------- configure
        {
            "label": "CMake: configure (Debug)",
            "detail": "Configure the build directory with Ninja and the Debug build type.",
            "type": "shell",
            "command": "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "configure"
            }
        },
        {
            "label": "CMake: configure (pick build type)",
            "detail": "Configure the build directory with a build type of your choice.",
            "type": "shell",
            "command": "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=${input:buildType}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "configure"
            }
        },
        // -------------------------------------------------------------- build
        {
            "label": "CMake: build (Debug)",
            "detail": "Build into ./build. This is the default build task, bound to Ctrl+Shift+B.",
            "type": "shell",
            "command": "cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure (Debug)",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true,
                "group": "build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: build (verbose)",
            "detail": "Same build, but every compiler command line is printed.",
            "type": "shell",
            "command": "cmake --build build --verbose",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure (Debug)",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "build"
            }
        },
        {
            "label": "CMake: build (Release)",
            "detail": "Separate build directory so Debug and Release can coexist.",
            "type": "shell",
            "command": "cmake -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true,
                "group": "build"
            },
            "group": "build"
        },
        {
            "label": "CMake: rebuild from scratch",
            "detail": "Wipes ./build and configures and builds again. Use when CMake cache is stale.",
            "type": "shell",
            "command": "rm -rf build && cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "build"
            }
        },
        {
            "label": "CMake: clean",
            "detail": "Removes build artefacts, keeps the configuration.",
            "type": "shell",
            "command": "cmake --build build --target clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        // ---------------------------------------------------------------- run
        {
            "label": "Run: version",
            "detail": "Smoke test that the binary exists and links.",
            "type": "shell",
            "command": "${workspaceFolder}/build/src/invoicedrop --version",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "run"
            }
        },
        {
            "label": "Run: extract text from a file",
            "detail": "Phase 1 interface: print what the extractor found, no model involved.",
            "type": "shell",
            "command": "${workspaceFolder}/build/src/invoicedrop --extract-only '${input:invoiceFile}'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "run"
            }
        },
        {
            "label": "Run: extract and dump page images",
            "detail": "Writes the rasterised pages as JPEG so the raster, downscale and colour order can be checked by eye.",
            "type": "shell",
            "command": "mkdir -p '${input:dumpDir}' && ${workspaceFolder}/build/src/invoicedrop --extract-only --dump-images '${input:dumpDir}' '${input:invoiceFile}'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "run"
            }
        },
        {
            "label": "Run: extract as JSON",
            "detail": "Same as above but one JSON object on stdout, for piping into jq.",
            "type": "shell",
            "command": "${workspaceFolder}/build/src/invoicedrop --extract-only --json '${input:invoiceFile}'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "run"
            }
        },
        // ------------------------------------------------------------ install
        // Installs into ~/.local, which needs no root and is on PATH already.
        // A separate build directory is required rather than --prefix on the
        // existing one: the systemd unit and the D-Bus service file are
        // configure_file templates, and ExecStart is baked in from
        // CMAKE_INSTALL_FULL_BINDIR at configure time. Installing build/ with a
        // prefix override would place a unit whose ExecStart points at
        // /usr/local/bin, where nothing was installed.
        //
        // CMAKE_INSTALL_PREFIX is the one setting that must be right at
        // configure time, so it goes into build-local once. Changing any -D
        // below later needs the directory removed first, otherwise CMake keeps
        // the cached value and the new flag is ignored without a word.
        {
            "label": "Install: local (build + install to ~/.local)",
            "detail": "Configures build-local, builds Release and installs into ~/.local: binary, symlink, systemd unit, D-Bus service, desktop entry, icon, LICENSE and the plasmoid. Testing is off here to keep the install quick; use the Debug build for that. Plasma caches loaded widgets, so restart plasmashell or re-add the widget before expecting a change to show up.",
            "type": "shell",
            "command": "cmake -B build-local -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$HOME/.local\" -DBUILD_TESTING=OFF && cmake --build build-local && cmake --install build-local",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "install"
            }
        },
        {
            "label": "Install: local (verify)",
            "detail": "Lists what was installed from the manifest cmake wrote, shows which invoicedrop the shell resolves, and runs doctor through the installed binary. A stale copy earlier on PATH is the usual reason a change seems to have no effect.",
            "type": "shell",
            "command": "test -f build-local/install_manifest.txt && sort -u build-local/install_manifest.txt; echo; echo '=== which invoicedrop ==='; which invoicedrop; echo; \"${env:HOME}/.local/bin/invoicedrop\" doctor",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "install"
            }
        },
        {
            "label": "Install: local (uninstall)",
            "detail": "Removes exactly the files cmake recorded in the manifest, plus the InvoiceDrop alias symlink, which the manifest does not mention because CMake creates it with install(CODE) and does not track it. Nothing outside ~/.local/bin and ~/.local/share is touched. Your invoices and history are safe: the database and inbox live in ~/.local/share/invoicedrop, which cmake never installed and this never deletes. Empty directories are left behind.",
            "type": "shell",
            "command": "test -f build-local/install_manifest.txt && xargs -r rm -f < build-local/install_manifest.txt && rm -f \"${env:HOME}/.local/bin/InvoiceDrop\" && rm -f build-local/install_manifest.txt && echo 'InvoiceDrop removed from ~/.local' || echo 'build-local/install_manifest.txt is missing, so there is nothing to remove'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "install"
            }
        },
        // --------------------------------------------------------------- test
        {
            "label": "Test: run (ctest)",
            "detail": "Runs the QTest binaries registered with CTest.",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "test"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Test: build and run",
            "detail": "Full loop: configure, build, then run the tests.",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "test"
            },
            "group": "test"
        },
        {
            "label": "Test: list",
            "detail": "Shows which tests CTest discovered.",
            "type": "shell",
            "command": "ctest --test-dir build --show-only",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "test"
            }
        },
        {
            "label": "Test: run (verbose)",
            "detail": "Same run, but the qInfo lines are shown. That is where the per-document timings, character counts and page counts appear.",
            "type": "shell",
            "command": "ctest --test-dir build -V --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "test"
            },
            "group": "test"
        },
        {
            "label": "Test: run one case",
            "detail": "Runs a single test slot of tst_documentreader, for example testDataIsRead or testDataIsRead:'Rechnung 2.jpg'.",
            "type": "shell",
            "command": "${workspaceFolder}/build/tests/tst_documentreader '${input:testCase}'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build (Debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "group": "test"
            },
            "group": "test"
        },
        {
            "label": "Test: rerun failed",
            "detail": "Re-runs only the tests that failed in the previous run.",
            "type": "shell",
            "command": "ctest --test-dir build --rerun-failed --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "group": "test"
            },
            "group": "test"
        },
        // ------------------------------------------------------------- checks
        {
            "label": "Check: dependencies",
            "detail": "Prints the pkg-config versions the build relies on.",
            "type": "shell",
            "command": "pkg-config --modversion mupdf lept tesseract; tesseract --list-langs",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Check: clang-format (dry run)",
            "detail": "Lists files that do not match .clang-format. Needs clang installed.",
            "type": "shell",
            "command": "clang-format --dry-run --Werror (find src tests -name '*.cpp' -o -name '*.h')",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ],
    "inputs": [
        {
            "id": "invoiceFile",
            "type": "promptString",
            "description": "Invoice to read (PDF, JPEG, PNG)",
            "default": "${env:HOME}/Rechnungen/rechnung.pdf"
        },
        {
            "id": "dumpDir",
            "type": "promptString",
            "description": "Directory for the dumped page images",
            "default": "/tmp/invoicedrop-pages"
        },
        {
            "id": "buildType",
            "type": "pickString",
            "description": "CMake build type",
            "options": [
                "Debug",
                "Release",
                "RelWithDebInfo",
                "MinSizeRel"
            ],
            "default": "Debug"
        },
        {
            "id": "testCase",
            "type": "promptString",
            "description": "Test slot to run (function name, optionally with a data row in single quotes)",
            "default": "testDataIsRead"
        }
    ]
}
