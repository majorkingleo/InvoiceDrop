post_install() {
    cat <<'EOF'
InvoiceDrop is installed, but it needs a model to read anything:

    ollama pull gemma4:latest

Check the setup with:

    invoicedrop doctor

To read every invoice dropped into the inbox folder, enable the watcher:

    systemctl --user enable --now invoicedrop

Add the widget with: right click the panel, Add Widgets, search InvoiceDrop.
EOF
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl --user disable --now invoicedrop.service 2>/dev/null || true
}

post_remove() {
    cat <<'EOF'
Your invoices and the database are still in ~/.local/share/invoicedrop.
Remove them by hand if you want them gone.
EOF
}
