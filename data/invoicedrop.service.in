[Unit]
Description=InvoiceDrop invoice watcher
Documentation=file://@CMAKE_SOURCE_DIR@/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/invoicedrop daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
